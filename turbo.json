{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "@uigrove/web#build": {
      "dependsOn": [
        "^build",
        "@uigrove/build#generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "generate": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "../../apps/web/public/r/**",
        "../../apps/web/generated/**"
      ],
      "env": [
        "UIGROVE_SITE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "agentGuidance": false
}
